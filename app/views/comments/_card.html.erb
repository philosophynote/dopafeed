<% persona = comment.persona %>
<% state = comment.state %>
<li id="<%= dom_id(comment) %>" class="flex gap-3 rounded-lg bg-white p-3" data-persona-id="<%= persona.slug %>" data-state="<%= state %>">
  <span class="flex size-9 shrink-0 items-center justify-center rounded-full text-sm font-bold text-white"
        style="background-color: <%= persona.color %>" aria-hidden="true"><%= persona.name.first %></span>
  <div class="min-w-0 flex-1">
    <p class="flex flex-wrap items-center gap-1 text-sm font-bold text-gray-900">
      <%= persona.name %><span class="rounded bg-gray-200 px-1 text-[10px] font-bold text-gray-600">AI</span>
    </p>
    <p class="text-xs text-gray-500"><%= persona.title %></p>
    <% case state %>
    <% when :written %>
      <p class="mt-1 break-words text-sm leading-relaxed text-gray-800"><%= comment.body %></p>
    <% when :writing %>
      <%# 途中の本文はこの枠にだけ届く。書き上がったカードには枠が無いので、遅れて届いた途中の本文で戻らない %>
      <p id="<%= dom_id(comment, :written) %>" class="mt-1 break-words text-sm leading-relaxed text-gray-800 empty:hidden"><%= local_assigns[:written] %></p>
      <p class="mt-1 text-sm text-gray-400 motion-safe:animate-pulse" role="status">書いています…</p>
    <% else %>
      <% if comments_budget_exhausted? %>
        <p class="mt-1 text-sm text-gray-500">今日はもう口を出せません</p>
      <% else %>
        <p class="mt-1 text-sm text-gray-500">口を出せませんでした</p>
        <%= button_to "もう一度", retry_article_comments_path(comment.article_id, persona_comment_id: comment.id), form_class: "mt-2",
                      class: "flex h-11 w-full items-center justify-center rounded-full bg-gray-800 text-sm font-bold text-white active:bg-gray-700" %>
      <% end %>
    <% end %>
  </div>
</li>
