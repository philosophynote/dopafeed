<% content_for :title, "コメント" %>
<header class="sticky top-0 z-10 -mx-4 -mt-4 flex items-center justify-between bg-gray-100/90 px-4 py-1 backdrop-blur">
  <%= link_to "フィードに戻る", root_path, class: "inline-flex h-11 items-center rounded-full px-3 text-sm font-semibold text-gray-700 active:bg-white" %>
  <p class="text-sm font-black tracking-tight">コメント</p>
</header>

<article class="mt-3 rounded-xl bg-white p-4">
  <p class="text-xs text-gray-500"><%= @article.feed.title %></p>
  <h1 class="mt-1 text-base font-bold leading-snug text-gray-900"><%= @article.title %></h1>
  <%= render "comments/box", article: @article, except: @except %>
</article>
