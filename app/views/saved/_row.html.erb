<%# Saved の 1 行。見た目は Main の行（articles/_row_body）と同じで、行全体を覆うボタンかリンクから開く。
    未読なら Main と同じ「読む」の POST（ルーレット → Reader。XP も普段どおり）。読み終えた記事は抽選し直さず、XP の付かない Reader を開くだけ %>
<li id="<%= dom_id(article) %>" class="relative">
  <article class="relative flex items-start gap-3 bg-white px-4 py-3">
    <% read = article.reading&.completed? %>
    <%= render "articles/row_body", article: article, read_mark: read %>
    <% cover = "absolute inset-0 w-full [-webkit-tap-highlight-color:transparent] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-orange-500 active:bg-black/5" %>
    <% if read %>
      <%= link_to read_article_path(article), class: cover do %>
        <span class="sr-only">「<%= article.title %>」を開く</span>
      <% end %>
    <% else %>
      <%= button_to article_reading_path(article), form: { class: "contents" }, class: cover do %>
        <span class="sr-only">「<%= article.title %>」を読む</span>
      <% end %>
    <% end %>
  </article>
</li>
