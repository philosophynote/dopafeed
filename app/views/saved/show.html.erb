<%# Saved（docs/screens/saved.md）。上から: 見出し / 取り置いた記事の一覧（保存した新しい順） / タブバー %>
<% content_for :title, "保存" %>
<header class="flex min-h-11 items-center">
  <%# 数は保存を外すたびに Turbo Stream が書き換える %>
  <h1 class="text-2xl font-black tracking-tight">保存 (<span id="saved-count"><%= @articles.size %></span>)</h1>
</header>

<section class="mt-4" aria-label="保存した記事">
  <% if @articles.empty? %>
    <%= render "saved/empty" %>
  <% else %>
    <ul class="swipe-list divide-y divide-gray-100 overflow-hidden rounded-2xl bg-white shadow-sm">
      <% @articles.each do |article| %>
        <%= render "saved/row", article: article %>
      <% end %>
    </ul>
    <%# 保存を全部外すと一覧は隠した跡だけになる。そのときだけ CSS が空状態を出す %>
    <div class="swipe-list-empty"><%= render "saved/empty" %></div>
  <% end %>
</section>

<%= render "main/tab_bar" %>
