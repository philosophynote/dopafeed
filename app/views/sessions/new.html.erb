<%# Login（docs/screens/login.md）。ユーザーは 1 人なのでパスワードだけ。パスキーのボタンは置かない（ADR 0005） %>
<div class="flex min-h-[80dvh] flex-col justify-center">
  <header class="text-center">
    <h1 class="text-4xl font-black tracking-tight">
      <span class="text-orange-500">Dopa</span>Feed
    </h1>
    <p class="mt-2 text-sm text-gray-500">自分専用。公開 URL なのでログインが要ります</p>
  </header>

  <% if alert = flash[:alert] %>
    <p class="mt-6 rounded-xl bg-red-50 px-4 py-3 text-sm font-semibold text-red-600" id="alert" role="alert"><%= alert %></p>
  <% end %>

  <%= form_with url: session_url, class: "mt-6 rounded-2xl bg-white p-4 shadow-sm" do |form| %>
    <%# iCloud キーチェーンがパスワードを保存・自動入力するには username 欄が要る。メールを公開ページに出さないよう固定の名前にし、送らない %>
    <input type="text" value="dopafeed" autocomplete="username" readonly tabindex="-1" aria-hidden="true" class="sr-only">

    <%= form.label :password, "パスワード", class: "block text-sm font-bold text-gray-500" %>
    <%= form.password_field :password, required: true, autofocus: true, autocomplete: "current-password", autocapitalize: "off", autocorrect: "off", spellcheck: false, maxlength: 72,
          class: "mt-2 block h-12 w-full rounded-xl border border-gray-300 px-4 text-base focus:border-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-200" %>

    <%= form.submit "ログイン", class: "mt-4 block h-12 w-full cursor-pointer rounded-xl bg-orange-500 text-base font-bold text-white active:bg-orange-600" %>
  <% end %>

  <p class="mt-4 text-center text-xs leading-relaxed text-gray-500">
    ユーザーは 1 人だけ。ログイン状態は最後に開いてから <%= Authentication::REMEMBER_FOR.in_years.to_i %> 年保つので、普段この画面は出ません
  </p>
</div>
