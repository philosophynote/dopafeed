<%# 名前だけを Frame にするのは、入力中も件数・取得状態・削除ボタンを見せたままにするため %>
<%= turbo_frame_tag dom_id(feed, :title) do %>
  <div class="flex items-center justify-between gap-3">
    <h2 class="min-w-0 break-all text-lg font-bold"><%= feed.title %></h2>
    <%= link_to "名前を変更", edit_feed_path(feed), class: "flex min-h-11 min-w-11 shrink-0 items-center justify-center text-sm text-orange-600" %>
  </div>
<% end %>
