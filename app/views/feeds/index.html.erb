<header class="flex items-center justify-between gap-3">
  <h1 class="text-2xl font-bold">購読 (<%= @feeds.size %>)</h1>
  <%= link_to "フィードを追加", new_feed_path, class: "flex min-h-11 items-center rounded-full bg-white px-4 text-sm text-orange-600", data: { turbo_frame: "turbo_add_feed" } %>
</header>
<ul class="mt-4 space-y-3 overflow-hidden" aria-label="購読中のフィード">
  <% @feeds.each do |feed| %>
    <li class="touch-pan-y rounded-2xl bg-white p-4 shadow-sm" data-feed data-controller="feed-swipe"
        data-feed-swipe-ratio-value="<%= Dopamine.settings.dig(:swipe, :dismiss_threshold_ratio) %>"
        data-action="pointerdown->feed-swipe#start pointermove->feed-swipe#move pointerup->feed-swipe#end pointercancel->feed-swipe#cancel lostpointercapture->feed-swipe#cancel">
      <h2 class="break-all text-lg font-bold"><%= feed.title %></h2>
      <p class="break-all text-xs text-gray-500"><%= feed.url %></p>
      <p class="mt-2 text-sm"><%= @article_counts.fetch(feed.id, 0) %>件・未読 <%= @unread_counts.fetch(feed.id, 0) %></p>
      <div class="flex items-center justify-between gap-3">
        <p class="text-xs text-gray-500">
          <% if feed.last_fetched_at %>
            最終取得 <time datetime="<%= feed.last_fetched_at.iso8601 %>"><%= time_ago_in_words(feed.last_fetched_at, locale: :ja) %>前</time>
          <% else %>
            未取得
          <% end %>
        </p>
        <%= button_to "削除", feed_path(feed), method: :delete, class: "min-h-11 min-w-11 text-sm text-red-600",
                      data: { feed_swipe_target: "delete" }, form: { data: { turbo_confirm: "「#{feed.title}」を削除しますか？記事・保存・読了記録も削除され、累計 XP・読了数・連続日数が変わります。達成済みの宝箱は残ります。" } } %>
      </div>
      <% if feed.last_error.present? %>
        <p class="break-all text-sm text-red-600"><%= feed.last_error %></p>
      <% end %>
    </li>
  <% end %>
</ul>
<% if @feeds.empty? %>
  <p class="mt-8 text-center text-gray-500">購読中のフィードはありません</p>
<% end %>
<p class="mt-4 text-xs text-gray-500">左にスワイプ、または削除ボタンで削除します。取得に失敗したフィードは赤字でエラーが出ます。</p>
<%= render "main/tab_bar" %>
