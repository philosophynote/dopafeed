<%# 記事の末尾。スクロールで画面に入ってきたら reader が 1 回だけ送る。最初から見えている短い記事と JS が無いときはボタンで送る %>
<%= form_with url: advance_reading_path(reading), id: dom_id(reading, :end), data: { controller: "reader" } do |form| %>
  <%= form.button "読み終えた", type: :submit, class: "flex h-12 w-full items-center justify-center rounded-full bg-gray-900 text-base font-bold text-white active:bg-gray-700" %>
<% end %>
