<%# 完読していなければ区切りの的は画面に無く、その分は捨てられる。帯は最後に置く（差し替えで購読が外れる） %>
<% if reading.completed? %>
  <%= turbo_stream.replace dom_id(reading, :card_title), partial: "readings/card_title", locals: { reading: reading } %>
  <%= turbo_stream.replace dom_id(reading, :card), partial: "cards/card", locals: { card: reading } %>
<% end %>
<%= turbo_stream.replace dom_id(reading, :rarity), partial: "readings/rarity_band", locals: { reading: reading, stop: true } %>
