<%# 枠の帯。記事の中身の判定で決まった希少度（readings.tier）を、完読で手に入るカードの予告として見せる。
    判定が届くまでは段のリールを回し続け、届いたら配られた帯（stop: true）がリールを止めて段の音を鳴らす。
    色は段が上がるほど目立たせる。現れた瞬間に光るのは一番下の段以外だけ（毎回光ると慣れる）。
    購読を外側の div に含めないと、枠が決まった後も購読が溜まる %>
<% tier = reading.tier %>
<% stop = tier && local_assigns[:stop] %>
<% band = tier ? rarity_tone(tier, base: "bg-orange-50 text-orange-700") : "bg-gray-100 text-gray-600" %>
<% band = "tier-glow #{band}" if rarity_cue(tier) %>
<% duration = Dopamine.settings.dig(:cards, :reveal_duration_ms) %>
<div id="<%= dom_id(reading, :rarity) %>">
  <%= turbo_frame_tag dom_id(reading, :rarity_band) do %>
    <p class="inline-block rounded-full px-3 py-1 text-xs font-semibold <%= band %> <%= "reel-gold" if stop && reading.jackpot? %>"
       data-tier="<%= tier %>" data-state="<%= tier ? "ready" : "pending" %>"
       <%= tag.attributes(data: { controller: "fanfare", action: "turbo:before-cache@document->fanfare#skip" }, style: "--glow-delay: #{duration}ms") if stop %>>
      <% if tier.nil? %>
        <%# 回る札は ::before に積む（実の要素に置くと、文字にも読み上げにも札が混じる） %>
        <% labels = pending_reel_labels %>
        判定中 <span class="reel reel-pending" aria-hidden="true" data-reel="<%= labels.join("\n") %>" style="--reel-steps: <%= labels.size %>"><span class="reel-inner" data-reel="<%= labels.join("\n") %>">&nbsp;</span></span> ・ 中身で枠が決まる
      <% else %>
        <%= sfx_cue(rarity_cue(tier), delay: duration) if stop %>
        <% label = rarity_label(tier) %>
        <% label = tag.span(tag.span(label, class: "reel-inner", data: { reel: reel_labels(tier).join("\n") }), class: "reel", style: "--reel-steps: #{reel_labels(tier).size}; --reel-duration: #{duration}ms") if stop %>
        <%= safe_join([ judgment_note(reading), label ].compact, " ") %> ・ 完読で<%= card_name(tier) %>
      <% end %>
    </p>
    <%# 頂点のコインは、帯のある欄の中だけで降らせる（一覧では全画面を出さない。ADR 0019） %>
    <% if stop && reading.jackpot? %>
      <span class="coins" aria-hidden="true" data-controller="fanfare" data-action="turbo:before-cache@document->fanfare#skip"
            style="--reel-duration: <%= duration %>ms"><% 8.times { |i| %><span style="--i: <%= i %>"></span><% } %></span>
    <% end %>
  <% end %>
  <% if tier.nil? %>
    <div data-controller="pending-refresh" data-pending-refresh-url-value="<%= tier_reading_path(reading) %>"
         data-pending-refresh-frame-value="<%= dom_id(reading, :rarity_band) %>">
      <%= turbo_stream_from reading, :tier %>
    </div>
  <% end %>
</div>
