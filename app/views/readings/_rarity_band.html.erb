<%# 出目の帯。抽選済みの希少度（readings.tier）を、完読で手に入るカードの予告として見せる。
    色は段が上がるほど目立たせる（レアは橙、頂点の金は金色）。現れた瞬間に光るのは通常以外だけ（毎回光ると慣れる） %>
<% band = rarity_tone(reading.tier, base: "bg-orange-50 text-orange-700") %>
<% band = "tier-glow #{band}" unless base_rarity?(reading.tier) %>
<%# 鳴らすのは Main で行を広げて抽選した瞬間だけ（sfx: true）。Reader の帯は、最初の 1 本ならルーレットが止まったときに鳴らし済みで、
    継ぎ足した次の記事なら同じ瞬間に区切りの音が鳴るので、一番大きい 1 つに譲る %>
<% cue = rarity_cue(reading.tier) if local_assigns[:sfx] %>
<%# 抽選した瞬間（sfx: true）だけ、出目をリールとして回して止める。止まるまでの札は ::before に積む（実の要素に置くと、文字にも読み上げにも札が混じる） %>
<% reel = local_assigns[:sfx] %>
<% duration = Dopamine.settings.dig(:cards, :reveal_duration_ms) %>
<p class="inline-block rounded-full px-3 py-1 text-xs font-semibold <%= band %> <%= "reel-gold" if reel && reading.jackpot? %>" data-tier="<%= reading.tier %>"
   <%= tag.attributes(data: { controller: "fanfare", action: "turbo:before-cache@document->fanfare#skip" }, style: "--glow-delay: #{duration}ms") if reel %>>
  <%= sfx_cue(cue, delay: (duration if reel)) %>
  <% if reel %>
    <% labels = reel_labels(reading.tier) %>
    出目 <span class="reel" style="--reel-steps: <%= labels.size %>; --reel-duration: <%= duration %>ms"><span class="reel-inner" data-reel="<%= labels.join("\n") %>"><%= rarity_label(reading.tier) %></span></span> ・ 完読で<%= card_name(reading.tier) %>
  <% else %>
    出目 <%= rarity_label(reading.tier) %> ・ 完読で<%= card_name(reading.tier) %>
  <% end %>
</p>
