<% if @expand %>
  <%= turbo_stream.replace dom_id(@article, :detail) do %>
    <%# 鳴らすのは抽選した応答だけ。再読込の後に広げ直した行は、出目を使い回すので鳴らさない %>
    <%= render "main/article_detail", reading: @reading, sfx: @reading.previously_new_record? %>
  <% end %>
<% else %>
  <%= turbo_stream.update "roulette" do %>
    <%= render "roulette", reading: @reading, article: @article %>
  <% end %>
<% end %>
