<%# ReadDone（docs/screens/read_done.md）。滞在・判定・XP の内訳・3 行要約・今日のゴール・次の 1 本 %>
<% completed = @reading.completed? %>
<% breakdown = @reading.xp_breakdown %>
<header class="mt-2 text-center">
  <% if completed %>
    <p class="text-3xl font-black text-orange-500">読了！</p>
    <p class="mt-1 text-sm font-semibold text-gray-600"><%= @reading.combo_count %> 本連続 ・ コンボ ×<%= number_with_precision(@reading.combo_multiplier, precision: 1) %></p>
  <% else %>
    <p class="text-3xl font-black text-gray-500">未完</p>
    <p class="mt-1 text-sm text-gray-500">もう少し読むと XP が付く</p>
  <% end %>
</header>

<section class="mt-4 rounded-2xl bg-white p-4 shadow-sm" aria-label="記事">
  <p class="text-xs font-semibold text-gray-500"><%= @article.feed.title %></p>
  <h1 class="mt-1 text-base font-bold leading-snug"><%= link_to @article.title, @article.url, target: "_blank", rel: "noopener" %></h1>
</section>

<section class="mt-3 grid grid-cols-2 gap-3" aria-label="計測">
  <div class="rounded-2xl bg-white p-4 shadow-sm">
    <p class="text-xs text-gray-500">滞在</p>
    <p class="mt-1 text-lg font-bold">滞在 <%= dwell_in_words(@reading.dwell_seconds) %></p>
  </div>
  <div class="rounded-2xl bg-white p-4 shadow-sm">
    <p class="text-xs text-gray-500">判定</p>
    <p class="mt-1 text-lg font-bold <%= completed ? "text-orange-600" : "text-gray-500" %>">判定 <%= completed ? "完読" : "未完" %></p>
  </div>
</section>

<section class="mt-3 rounded-2xl bg-white p-4 shadow-sm" aria-label="XP の内訳">
  <% if completed %>
    <dl class="space-y-1 text-sm">
      <div class="flex justify-between"><dt>完読ボーナス</dt><dd class="font-semibold">完読ボーナス +<%= breakdown[:bonus] %> XP</dd></div>
      <div class="flex justify-between"><dt>コンボ ×<%= number_with_precision(@reading.combo_multiplier, precision: 1) %></dt><dd class="font-semibold">+<%= breakdown[:combo] %> XP</dd></div>
      <div class="mt-2 flex justify-between border-t border-gray-100 pt-2 text-base"><dt class="font-bold">合計</dt><dd class="font-black text-orange-600">合計 +<%= breakdown[:total] %> XP</dd></div>
    </dl>
  <% else %>
    <p class="text-base font-bold text-gray-500">合計 +0 XP</p>
  <% end %>
  <p class="mt-3 text-xs text-gray-500">記事を開いてアプリに戻るまでの時間で計測。<%= Dopamine.settings.dig(:read, :complete_after_seconds) %> 秒未満なら XP なし</p>
</section>

<section class="mt-3 rounded-2xl bg-white p-4 shadow-sm" aria-label="要約">
  <p class="text-xs font-semibold text-gray-500">Claude の 3 行要約（<%= Dopamine.settings.dig(:claude, :summary_model) %>）</p>
  <% if @article.summary.present? %>
    <p class="mt-2 whitespace-pre-line text-sm leading-relaxed text-gray-800"><%= @article.summary %></p>
  <% else %>
    <p class="mt-2 text-sm text-gray-400">要約を準備中</p>
  <% end %>
</section>

<section class="mt-3 rounded-2xl bg-white p-4 shadow-sm" aria-label="今日のゴール">
  <% remaining = @goal_articles - @today_count %>
  <p class="text-sm font-semibold">今日のゴール <%= @today_count %> / <%= @goal_articles %> ・ <%= remaining.positive? ? "あと #{remaining} 本で宝箱" : "読み切った！" %></p>
</section>

<section class="mt-3" aria-label="次の 1 本">
  <p class="px-1 text-xs font-semibold text-gray-500">次の 1 本</p>
  <% if @next_article %>
    <div class="mt-1"><%= render "main/article_card", article: @next_article %></div>
  <% else %>
    <div class="mt-1"><%= render "main/empty" %></div>
  <% end %>
</section>

<div class="mt-4">
  <%= link_to "閉じる", root_path, class: "flex h-12 w-full items-center justify-center rounded-full bg-gray-900 text-base font-bold text-white active:bg-gray-700" %>
</div>
