<%# Roulette（docs/screens/roulette.md）。抽選は済んでいる（reading.tier）。ここは出目の帯を回し、止まった瞬間にリンクを踏ませるだけ。
    帯は希少度を何周か並べ、止まる行が中央（3 行窓の 2 行目）に来るよう CSS 変数で位置を渡す。
    data-turbo-temporary: Jackpot へ Turbo で進んだ後に戻っても、スナップショットからモーダルが蘇って回り直さないように %>
<% rarities = Dopamine.rarities %>
<% duration = Dopamine.settings.dig(:cards, :reveal_duration_ms) %>
<% laps = 3 %>
<% stop = rarities.index { |rarity| rarity[:name] == reading.tier } + rarities.size * laps %>
<%# --roulette-duration は帯（.roulette-window）と結果の行（.roulette-result）の両方が読むので、共通の親であるここに置く %>
<div class="fixed inset-0 z-40 flex items-center justify-center bg-black/60 p-4" role="dialog" aria-modal="true" aria-label="ルーレット"
     style="--roulette-duration: <%= duration %>ms"
     data-controller="roulette" data-roulette-duration-value="<%= duration %>" data-tier="<%= reading.tier %>" data-turbo-temporary>
  <div class="w-full max-w-md rounded-[28px] bg-white p-5 shadow-2xl">
    <p class="text-center text-xs font-semibold text-gray-500">「読む」を押した <%= reveal_seconds %> 秒間</p>

    <div class="roulette-window mt-3 overflow-hidden rounded-2xl bg-gray-900" style="--roulette-stop: <%= stop - 1 %>" aria-hidden="true">
      <ul class="roulette-strip">
        <% (laps + 2).times do %>
          <% rarities.each do |rarity| %>
            <li class="roulette-row flex items-center justify-center text-2xl font-black text-white" data-tier="<%= rarity[:name] %>"><%= card_name(rarity[:name]) %></li>
          <% end %>
        <% end %>
      </ul>
      <div class="pointer-events-none absolute inset-x-3 top-1/2 h-12 -translate-y-1/2 rounded-xl border-2 border-orange-400"></div>
    </div>

    <% if !base_rarity?(reading.tier) && !reading.jackpot? %>
      <p class="roulette-result mt-3 text-center text-base font-bold text-orange-600"><%= card_name(reading.tier) %>が懸かった！ 完読で手に入る</p>
    <% end %>

    <table class="mt-3 w-full text-sm" aria-label="出目表">
      <tbody>
        <% rarities.each do |rarity| %>
          <tr class="<%= rarity[:name] == reading.tier ? "font-bold text-orange-600" : "text-gray-600" %>" data-tier="<%= rarity[:name] %>" <%= "data-selected" if rarity[:name] == reading.tier %>>
            <td class="py-1"><%= card_name(rarity[:name]) %></td>
            <td class="py-1 text-right"><%= rarity_percent(rarity) %>%</td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <p class="mt-3 text-center text-xs text-gray-500">止まると記事が開きます</p>

    <%# 止まった瞬間に roulette が踏むリンク。どちらも Turbo で進む（元サイトは Reader のカードから開く） %>
    <% if reading.jackpot? %>
      <%= link_to "ジャックポットへ", jackpot_reading_path(reading), class: "sr-only", data: { roulette_target: "link" } %>
    <% else %>
      <%= link_to "記事を開く", read_article_path(article), class: "sr-only", data: { roulette_target: "link" } %>
    <% end %>
  </div>
</div>
