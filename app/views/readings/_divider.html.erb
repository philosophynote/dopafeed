<%# 判定の区切り（docs/screens/reader.md）。「読み終えた」の form と置き換わり、手に入れたカードを見せてから次の 1 本へ流す。
    完読は出目の色（通常とレアは橙、金は金色）、未完は灰。責める文言は出さず、どうすれば手に入るかだけ言う %>
<% completed = reading.completed? %>
<% tone = if !completed then "bg-gray-200 text-gray-700" elsif reading.jackpot? then "bg-amber-400 text-amber-950" else "bg-orange-500 text-white" end %>
<section id="<%= dom_id(reading, :result) %>" class="rounded-2xl p-4 text-center <%= tone %>" aria-label="判定" data-tier="<%= reading.tier %>" data-completed="<%= completed %>">
  <% if completed %>
    <p class="text-xs font-semibold opacity-90">読了</p>
    <p class="text-2xl font-black"><%= card_name(reading.tier) %>を手に入れた！</p>
    <p class="mt-1 text-sm">滞在 <%= dwell_in_words(reading.dwell_seconds) %> ・ <%= reading.combo_count %> 本連続</p>
  <% else %>
    <p class="text-2xl font-black">カードにならなかった</p>
    <p class="mt-1 text-sm">滞在 <%= dwell_in_words(reading.dwell_seconds) %>。<%= Dopamine.settings.dig(:read, :complete_after_seconds) %> 秒以上読むと手に入る</p>
  <% end %>
  <% summary = DailySummary.new(ReadingDay.of(reading.returned_at)) %>
  <p class="mt-2 text-sm font-semibold"><%= daily_goal_line(summary) %></p>
  <%# 宝箱は今日の goal 本目の区切りにだけ出す。それ以降の区切りは「読み切った！」だけ（宝箱は Main のゴール表示からいつでも開ける）。
      リンク先は今日の宝箱なので、前の日の判定を描き直したときには出さない %>
  <% if summary.day == ReadingDay.of && summary.achieved_by?(reading) %>
    <%= link_to "宝箱を開く", daily_goal_path, class: "mt-3 flex h-12 w-full items-center justify-center rounded-full bg-[#FFD166] text-base font-bold text-gray-900 active:bg-yellow-300" %>
  <% end %>
</section>
