<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Dopafeed" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Dopafeed">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#f3f4f6">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# config.x は設定していない鍵に空の OrderedOptions（真）を返すので、真偽ではなく true と比べる %>
    <%= tag.meta name: "sfx-record" if Rails.configuration.x.sfx_record == true %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%# public/ の固定 URL だと 1 年キャッシュで差し替えが届かず、iOS は追加し直しても古い画像を拾う %>
    <%= tag.link rel: "icon", href: image_path("icon.png"), type: "image/png" %>
    <%= tag.link rel: "icon", href: image_path("icon.svg"), type: "image/svg+xml" %>
    <%= tag.link rel: "apple-touch-icon", href: image_path("icon-180.png") %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-dvh bg-gray-100 text-gray-900 antialiased">
    <main class="mx-auto w-full max-w-md px-4 pt-4 pb-24">
      <%= yield %>
      <%= turbo_frame_tag "turbo_add_feed" unless controller_name == "feeds" && %w[new create].include?(action_name) %>
      <%= render "shared/app_badge", unread_count: unread_count if authenticated? %>
    </main>
  </body>
</html>
