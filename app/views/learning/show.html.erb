</section>

<section class="mt-4 rounded-2xl bg-white shadow-sm" aria-label="アカウント">
  <%= button_to "サインアウト", session_path, method: :delete, class: "flex h-14 w-full items-center px-4 text-left font-semibold text-red-600 active:bg-red-50" %>
</section>
