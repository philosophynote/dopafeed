<header class="flex items-center gap-2">
  <%= link_to "戻る", root_path, class: "flex h-11 items-center rounded-full px-3 text-sm font-semibold text-orange-600 hover:bg-white" %>
  <h1 class="text-xl font-bold">設定</h1>
</header>

<section class="mt-4 rounded-2xl bg-white shadow-sm" aria-label="ホーム画面">
  <%= link_to install_path, class: "flex h-14 w-full items-center justify-between px-4 text-left active:bg-orange-50" do %>
    <span>ホーム画面に追加</span>
    <span class="text-xs text-gray-400">通知・バッジ ›</span>
  <% end %>
</section>

<section class="mt-4 rounded-2xl bg-white shadow-sm" aria-label="効果音">
  <button type="button" role="switch" aria-checked="true" class="group flex h-14 w-full items-center justify-between px-4 text-left active:bg-orange-50"
          data-controller="sound-toggle" data-action="sound-toggle#toggle">
    <span>効果音<span class="block text-xs text-gray-400">消音スイッチが ON のときは鳴らない</span></span>
    <span class="relative h-7 w-12 shrink-0 rounded-full bg-gray-300 transition-colors group-aria-checked:bg-orange-500" aria-hidden="true">
      <span class="absolute left-0.5 top-0.5 h-6 w-6 rounded-full bg-white shadow transition-transform group-aria-checked:translate-x-5"></span>
    </span>
  </button>
</section>

<section class="mt-4 rounded-2xl bg-white shadow-sm" aria-label="アカウント">
  <%= button_to "サインアウト", session_path, method: :delete, class: "flex h-14 w-full items-center px-4 text-left font-semibold text-red-600 active:bg-red-50" %>
</section>
