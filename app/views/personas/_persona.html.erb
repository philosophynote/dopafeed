<li id="<%= dom_id(persona) %>" class="flex items-start gap-3 rounded-2xl bg-white p-4 shadow-sm" data-persona>
  <div class="flex min-w-0 flex-1 gap-3">
    <span class="flex size-9 shrink-0 items-center justify-center rounded-full text-sm font-bold text-white <%= "opacity-50" unless persona.enabled %>"
          style="background-color: <%= persona.color %>" aria-hidden="true"><%= persona.name.first %></span>
    <div class="min-w-0">
      <div class="flex flex-wrap items-baseline gap-x-2">
        <h2 class="min-w-0 break-words text-sm font-bold text-gray-900 <%= "opacity-50" unless persona.enabled %>"><%= persona.name %></h2>
        <% unless persona.enabled %>
          <span class="rounded-full bg-gray-100 px-2 text-xs font-semibold text-gray-500" data-persona-off>オフ</span>
        <% end %>
      </div>
      <div class="<%= "opacity-50" unless persona.enabled %>">
        <p class="break-words text-xs text-gray-500"><%= persona.title %></p>
        <p class="mt-1 break-words text-xs leading-snug text-gray-700"><%= persona.description %></p>
      </div>
    </div>
  </div>
  <details id="<%= dom_id(persona, :menu) %>" class="relative -mt-2 -mr-2 shrink-0" name="persona-menu" data-controller="row-menu"
           data-action="pointerdown@document->row-menu#closeOutside focusout->row-menu#closeOnBlur keydown.esc@document->row-menu#escape turbo:before-cache@document->row-menu#close">
    <summary class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-full text-xl text-gray-500 [&::-webkit-details-marker]:hidden"
             aria-label="「<%= persona.name %>」の操作" data-row-menu-target="summary">⋯</summary>
    <div class="absolute top-full right-0 z-10 w-40 overflow-hidden rounded-xl bg-white shadow-lg ring-1 ring-gray-200">
      <%= link_to "変更", edit_persona_path(persona), class: "flex min-h-11 items-center px-4 text-sm", data: { action: "row-menu#choose" } %>
      <%# 一覧のフォームのままだと、次の行を押した送信が前の送信を止め、DB だけ変わって表示が食い違う。行ごとの frame で送信を分ける %>
      <%= turbo_frame_tag dom_id(persona, :switch_frame) do %>
        <%= button_to persona.enabled ? "オフにする" : "オンにする", persona_enablement_path(persona), method: :patch, params: { enabled: !persona.enabled },
                      class: "flex min-h-11 w-full items-center px-4 text-sm", data: { action: "row-menu#choose" } %>
      <% end %>
    </div>
  </details>
</li>
