<% content_for :title, "今週のレポート" %>
<% report = @report %>
<% counts = report.daily_counts %>
<% peak = counts.max %>
<% today = report.today %>
<header>
  <%= link_to collection_path, class: "-ml-2 inline-flex min-h-11 items-center gap-1 px-2 text-sm font-semibold text-gray-600 active:text-gray-900" do %>
    <span aria-hidden="true">‹</span>図鑑へ戻る
  <% end %>
</header>
<section class="mt-1 rounded-2xl bg-white p-4 shadow-sm">
  <div class="flex items-baseline justify-between gap-2">
    <h1 class="text-xl font-black tracking-tight">今週のレポート</h1>
    <p class="shrink-0 text-sm font-semibold text-gray-500"><%= report.start_day.strftime("%-m/%-d") %> – <%= report.end_day.strftime("%-m/%-d") %></p>
  </div>
  <p class="mt-1 text-sm font-semibold text-gray-600"><span aria-hidden="true">🔥</span><span class="sr-only">読んだ日が </span><%= report.streak_days %> 日連続</p>

  <div class="mt-3" role="group" aria-label="今週の本数">
    <p class="text-4xl font-black text-orange-600"><%= number_with_delimiter(report.count) %> <span class="text-base font-bold text-gray-700">本 読了</span></p>
    <p class="mt-1 text-sm font-semibold <%= report.change_percent.to_i.positive? ? "text-emerald-700" : "text-gray-500" %>">
      <%= week_change(report) %><% if report.change_percent %>（<%= report.previous_count %> 本）<% end %>
    </p>
  </div>

  <%# 0 本の日も枠を残し、曜日の位置で一週間の形が見えるようにする %>
  <ol class="mt-4 grid h-28 grid-cols-7 items-end gap-2" aria-label="曜日別">
    <% counts.each_with_index do |count, i| %>
      <% day = report.start_day + i %>
      <% state = day_state(day, today) %>
      <li class="flex h-full flex-col items-center justify-end gap-1" data-day-state="<%= state %>" aria-label="<%= WeeklyHelper::WEEKDAYS[i] %>曜 <%= count %> 本">
        <span class="text-xs font-bold text-gray-600" aria-hidden="true"><%= count if count.positive? %></span>
        <span class="w-full rounded-t-md bg-orange-400" style="height: <%= peak.positive? ? (count * 100.0 / peak).round : 0 %>%" aria-hidden="true"></span>
        <span class="text-xs font-semibold <%= { today: "text-orange-600", future: "text-gray-300" }.fetch(state, "text-gray-500") %>" aria-hidden="true"><%= WeeklyHelper::WEEKDAYS[i] %></span>
      </li>
    <% end %>
  </ol>

  <dl class="mt-4 space-y-2 border-t border-gray-100 pt-3 text-sm">
    <div class="flex items-baseline justify-between gap-2">
      <dt class="font-semibold text-gray-600">読書時間</dt>
      <dd class="font-bold"><%= hours_and_minutes(report.dwell_seconds) %></dd>
    </div>
    <% tiers = report.tier_counts %>
    <div class="flex items-baseline justify-between gap-2" role="group" aria-label="カード">
      <dt class="font-semibold text-gray-600">カード</dt>
      <dd class="text-right">
        <span class="font-bold"><%= report.count %> 枚</span>
        <span class="block text-xs text-gray-500"><%= rarity_breakdown(tiers) %></span>
      </dd>
    </div>
    <div class="flex items-baseline justify-between gap-2">
      <dt class="font-semibold text-gray-600">ひとこと要約</dt>
      <dd class="font-bold"><%= report.summarized_count %> 本</dd>
    </div>
  </dl>

  <% if report.feed_counts.any? %>
    <section class="mt-4 border-t border-gray-100 pt-3" aria-label="フィード別">
      <h2 class="text-sm font-semibold text-gray-600">フィード別</h2>
      <ul class="mt-1 space-y-1 text-sm">
        <% report.feed_counts.each do |feed, count| %>
          <li class="flex items-baseline justify-between gap-2">
            <span class="min-w-0 truncate"><%= feed.title %></span>
            <span class="shrink-0 font-bold"><%= count %></span>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</section>
<p class="mt-3 text-center text-xs text-gray-400">DopaFeed ・ 過去の自分と比べる週次カード</p>

<%= render "main/tab_bar" %>
