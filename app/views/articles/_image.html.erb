<%# 画像がポインタを受けると、行のスワイプよりドラッグや長押しが優先されてしまう %>
<% thumbnail = local_assigns.fetch(:thumbnail, false) %>
<% if article.image_url.present? %>
  <figure class="<%= thumbnail ? "aspect-[3/2] w-28 shrink-0 overflow-hidden rounded-lg bg-gray-100" : "-mx-4 -mt-4 mb-3 aspect-[1.91/1] overflow-hidden rounded-t-2xl bg-gray-100" %>" data-controller="image-fallback">
    <img src="<%= article.image_url %>" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" draggable="false"
         class="pointer-events-none h-full w-full select-none object-cover [-webkit-touch-callout:none]"
         data-image-fallback-target="image" data-action="error->image-fallback#remove">
  </figure>
<% end %>
