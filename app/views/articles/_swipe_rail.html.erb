<%# 引いた幅だけ伸びる丸型の背景（Stimulus swipe が幅と色を書く）。左へ引けば右端から（target: "rail"）、右へ引けば左端から（target: "saveRail"）伸びる。
    icon: :trash（削除）/ :bookmark（保存）/ :unbookmark（保存を外す）。閾値を越えたときの色は CSS の modifier（swipe-save-rail / swipe-unsave-rail）が決める %>
<% left = target == "saveRail" %>
<div class="swipe-rail <%= modifier %> absolute inset-y-1 <%= left ? "left-1 justify-start pl-5" : "right-1 justify-end pr-5" %> flex w-0 items-center overflow-hidden rounded-full text-white"
     data-swipe-target="<%= target %>" aria-hidden="true">
  <span class="flex shrink-0 flex-col items-center gap-0.5 text-[11px] font-bold">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-6 w-6">
      <% case icon %>
      <% when :trash %>
        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
      <% when :bookmark %>
        <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0 1 11.186 0Z" />
      <% when :unbookmark %>
        <path stroke-linecap="round" stroke-linejoin="round" d="m3 3 1.664 1.664M21 21l-1.5-1.5m-5.485-1.242L12 17.25 4.5 21V8.742m.164-4.078a2.15 2.15 0 0 1 1.743-1.342 48.507 48.507 0 0 1 11.186 0c1.1.128 1.907 1.077 1.907 2.185V19.5M4.664 4.664 19.5 19.5" />
      <% end %>
    </svg>
    <%= label %>
  </span>
</div>
