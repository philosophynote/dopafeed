<%# Reader の 1 枚。フィード名・見出し・出目の帯・Claude の 3 行要約（articles/_summary）と、元サイトを開く「記事を開く」。
    本文は描かない。元サイトの見た目のまま、別窓（iPhone のホーム画面アプリではシート）で読む（ADR 0011）。
    その下に「読み終えた」の form を置き、判定が済んでいれば form の代わりに結果を出す（再読込で二度送らない） %>
<% article = reading.article %>
<div class="flex flex-col gap-4" data-controller="sheet" data-sheet-start-url-value="<%= start_reading_path(reading) %>">
  <article id="<%= dom_id(article, :reader) %>" class="rounded-2xl bg-white p-4 shadow-sm">
    <p class="flex items-center gap-2 text-xs text-gray-500">
      <span class="font-semibold text-gray-700"><%= article.feed.title %></span>
      <% if article.published_at %>
        <span>・</span>
        <time datetime="<%= article.published_at.iso8601 %>"><%= time_ago_in_words(article.published_at, locale: :ja) %>前</time>
      <% end %>
    </p>
    <h1 class="mt-1 break-words text-xl font-bold leading-snug"><%= article.title %></h1>
    <p class="mt-2 inline-block rounded-full bg-orange-50 px-3 py-1 text-xs font-semibold text-orange-700">
      出目 <%= tier_label(reading.tier) %> ×<%= Dopamine.tier(reading.tier)[:multiplier] %> ・ 完読で +<%= reading.base_xp %> XP
    </p>

    <% state = summary_state(article) %>
    <%= render "articles/summary", article: article, state: state %>
    <%# 出来上がりを待つ間（作成中・その日の上限）は購読する。上限のカードも、日が変わって積み直した Job の差し替えを受ける。
        つながるたびに、作成中なら欄を取り直す（つながっていない間の差し替えは届かないため） %>
    <% if state.in?(%i[pending exhausted]) %>
      <div data-controller="summary-refresh" data-summary-refresh-url-value="<%= summary_article_path(article) %>"
           data-summary-refresh-frame-value="<%= dom_id(article, :summary) %>">
        <%= turbo_stream_from article, :summary %>
      </div>
    <% end %>

    <%= link_to "記事を開く", article.url, target: "_blank", rel: "noopener noreferrer", data: { action: "sheet#open" },
                class: "mt-4 flex h-12 w-full items-center justify-center rounded-full bg-orange-500 text-base font-bold text-white active:bg-orange-600" %>
  </article>

  <% if reading.returned_at %>
    <%= render "readings/divider", reading: reading %>
  <% else %>
    <%= render "readings/advance_form", reading: reading %>
  <% end %>
</div>
