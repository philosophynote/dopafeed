<%# 幅が足りない場合も今日の行動に関わる数は切らず、図鑑の枚数だけを省略する %>
<section id="status-card" class="mt-3" aria-label="今日の進み">
  <%# 先読みの GET でも宝箱を開いたことになるので、押す前に先読みさせない %>
  <%= link_to daily_goal_path, data: { turbo_prefetch: false }, class: "flex min-h-12 items-center gap-3 overflow-hidden whitespace-nowrap rounded-2xl bg-white px-4 text-sm shadow-sm active:bg-gray-50" do %>
    <span class="flex shrink-0 items-center gap-1 font-bold"><span aria-hidden="true">🔥</span><%= @streak_days %>日連続<span class="sr-only">、</span></span>
    <span class="flex shrink-0 items-center gap-1.5">
      <ol class="flex gap-1" aria-hidden="true">
        <% @goal_articles.times do |i| %>
          <li class="goal-dot h-2.5 w-2.5 rounded-full <%= i < @today_count ? "bg-orange-500" : "bg-gray-200" %>" data-filled="<%= i < @today_count %>"></li>
        <% end %>
      </ol>
      <span class="font-semibold"><span class="sr-only">今日のゴール </span><%= @today_count %> / <%= @goal_articles %><span class="sr-only">、</span></span>
    </span>
    <%# 弾ませた印のままスナップショットに残すと、履歴で戻るたびに弾み直す %>
    <span class="ml-auto min-w-0 truncate font-semibold text-gray-700 <%= "count-pop" if local_assigns[:pop] %>" data-cards-count
          <%= tag.attributes(data: { controller: "fanfare", action: "turbo:before-cache@document->fanfare#skip" }) if local_assigns[:pop] %>><span class="sr-only">図鑑 </span><%= number_with_delimiter(@cards_count) %> 枚</span>
    <% if @combo_count > 1 %>
      <% fever = Dopamine.settings.dig(:cards, :fever_combo) %>
      <span class="shrink-0 rounded-full px-2 py-0.5 text-xs font-bold <%= fever && @combo_count >= fever ? "fever-badge text-white" : "bg-orange-100 text-orange-700" %>" data-combo><span class="sr-only">、</span><%= @combo_count %> 連続</span>
    <% end %>
    <span class="sr-only">。宝箱を見る</span>
  <% end %>
</section>
