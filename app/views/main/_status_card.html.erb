<%# ステータスの 1 行。ストリーク・今日のゴール・累計 XP・コンボ。一画面に並ぶ記事を減らさないよう 1 行に詰め、行ごと宝箱（DailyGoal）への入口にする（達成前でも開ける）。
    未読数と読了累計は出さない（未読はタブバーのバッジにある）。見出しの語（今日のゴール・累計・コンボ）は読み上げにだけ残す。数字はコントローラが集め、本数の上限は dopamine.yml %>
<section class="mt-4" aria-label="今日の進み">
  <%= link_to daily_goal_path, class: "flex min-h-12 items-center gap-3 whitespace-nowrap rounded-2xl bg-white px-4 text-sm shadow-sm active:bg-gray-50" do %>
    <span class="flex items-center gap-1 font-bold"><span aria-hidden="true">🔥</span><%= @streak_days %>日連続</span>
    <span class="flex items-center gap-1.5">
      <ol class="flex gap-1" aria-hidden="true">
        <% @goal_articles.times do |i| %>
          <li class="goal-dot h-2.5 w-2.5 rounded-full <%= i < @today_count ? "bg-orange-500" : "bg-gray-200" %>" data-filled="<%= i < @today_count %>"></li>
        <% end %>
      </ol>
      <span class="font-semibold"><span class="sr-only">今日のゴール </span><%= @today_count %> / <%= @goal_articles %></span>
    </span>
    <span class="ml-auto font-semibold text-gray-700"><span class="sr-only">累計 </span><%= number_with_delimiter(@total_xp) %> XP</span>
    <% if @combo_multiplier > 1 %>
      <span class="rounded-full bg-orange-100 px-2 py-0.5 text-xs font-bold text-orange-700"><span class="sr-only">コンボ </span>×<%= number_with_precision(@combo_multiplier, precision: 1) %></span>
    <% end %>
  <% end %>
</section>
