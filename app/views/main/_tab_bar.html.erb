<%# フィード・保存・図鑑・購読の現在地を示す。図鑑はモックの「レポート」の枠（ADR 0020） %>
<nav class="fixed inset-x-0 bottom-0 border-t border-gray-200 bg-white/95 pb-[env(safe-area-inset-bottom)] backdrop-blur" aria-label="タブバー">
  <ul class="mx-auto grid max-w-md grid-cols-4">
    <li>
      <%= link_to root_path, class: "relative flex h-14 flex-col items-center justify-center text-xs font-semibold text-gray-500 aria-[current=page]:text-orange-600", "aria-label": "フィード", "aria-current": current_page?(root_path) ? "page" : nil do %>
        <span class="text-xl" aria-hidden="true">📰</span>
        <span>フィード</span>
        <%= render "main/unread_badge", unread_count: @unread_count %>
      <% end %>
    </li>
    <li>
      <%= link_to saved_path, class: "flex h-14 flex-col items-center justify-center text-xs font-semibold text-gray-500 aria-[current=page]:text-orange-600", "aria-current": current_page?(saved_path) ? "page" : nil do %>
        <span class="text-xl" aria-hidden="true">🔖</span>
        <span>保存</span>
      <% end %>
    </li>
    <li>
      <%= link_to collection_path, class: "flex h-14 flex-col items-center justify-center text-xs font-semibold text-gray-500 aria-[current=page]:text-orange-600", "aria-current": current_page?(collection_path) ? "page" : nil do %>
        <span class="text-xl" aria-hidden="true">🎴</span>
        <span>図鑑</span>
      <% end %>
    </li>
    <li>
      <%= link_to feeds_path, class: "flex h-14 flex-col items-center justify-center text-xs font-semibold text-gray-500 aria-[current=page]:text-orange-600", "aria-current": current_page?(feeds_path) ? "page" : nil do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6 w-6" aria-hidden="true"><circle cx="5" cy="19" r="1"></circle><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"></path></svg>
        <span>購読</span>
      <% end %>
    </li>
  </ul>
</nav>
