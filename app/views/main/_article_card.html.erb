<%# 通常カード。フィード名・相対時刻・見出し・要約 2 行・「読む」。要約が無ければ欄ごと出さない（見出しだけ） %>
<article class="rounded-2xl bg-white p-4 shadow-sm">
  <p class="flex items-center gap-2 text-xs text-gray-500">
    <span class="font-semibold text-gray-700"><%= article.feed.title %></span>
    <% if article.published_at %>
      <span>・</span>
      <time datetime="<%= article.published_at.iso8601 %>"><%= time_ago_in_words(article.published_at, locale: :ja) %>前</time>
    <% end %>
  </p>
  <h2 class="mt-1 text-base font-bold leading-snug"><%= article.title %></h2>
  <% if article.summary.present? %>
    <p class="mt-1 line-clamp-2 whitespace-pre-line text-sm text-gray-600"><%= article.summary %></p>
  <% end %>
  <div class="mt-3 flex justify-end">
    <%= render "readings/read_button", article: article %>
  </div>
</article>
