<div data-controller="process-mode" data-process-mode-small-every-value="<%= Dopamine.settings.dig(:delete_mode, :combo_small_every).to_i %>" data-process-mode-large-every-value="<%= Dopamine.settings.dig(:delete_mode, :combo_large_every).to_i %>" data-process-mode-swipe-outlet="[data-controller~='swipe']" data-action="turbo:before-cache@document->process-mode#reset pageshow@window->process-mode#reset swipe:removed->process-mode#removed swipe:remove-failed->process-mode#removeFailed turbo:submit-end@document->process-mode#submitted">
<%# 切り替えを別の行に置くと、一画面に入る記事の行が 1 本減る %>
<header class="flex items-center justify-between gap-2">
  <h1 class="text-2xl font-black tracking-tight">
    <span class="text-orange-500">Dopa</span>Feed
  </h1>
  <% unless @articles.empty? %>
    <fieldset class="process-mode-switch ml-auto flex rounded-xl bg-gray-200/70 p-0.5 text-sm font-bold text-gray-600 [&[hidden]]:hidden" data-process-mode-target="switch" data-action="change->process-mode#toggle">
      <legend class="sr-only">モード</legend>
      <% [ %w[read 読む], %w[process 処理] ].each do |value, label| %>
        <label class="flex h-11 w-14 cursor-pointer items-center justify-center rounded-[10px] has-checked:bg-white has-checked:text-gray-900 has-checked:shadow-sm has-focus-visible:outline-2 has-focus-visible:outline-orange-500">
          <input type="radio" name="mode" value="<%= value %>" class="sr-only" autocomplete="off" <%= "checked" if value == "read" %>><%= label %>
        </label>
      <% end %>
    </fieldset>
  <% end %>
  <div class="flex shrink-0 items-center <%= "ml-auto" if @articles.empty? %>">
    <%= link_to new_feed_path(from: "main"), class: "flex h-11 w-11 items-center justify-center rounded-full text-orange-600 hover:bg-white", title: "フィードを追加", data: { turbo_frame: "turbo_add_feed" } do %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-6 w-6" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
      <span class="sr-only">フィードを追加</span>
    <% end %>
    <%= link_to learning_path, class: "flex h-11 w-11 items-center justify-center rounded-full text-gray-600 hover:bg-white", "aria-label": "設定", title: "設定" do %>
      <%= render "shared/icon_gear" %>
      <span class="sr-only">設定</span>
    <% end %>
  </div>
</header>

<%# 処理モードの間はステータスの行にコンボを重ねる。別の行を足すと、一画面に入る記事の行が減る %>
<div class="relative">
  <div data-process-mode-target="status"><%= render "status_card" %></div>
  <% unless @articles.empty? %>
    <p class="process-mode-only absolute inset-0" data-process-mode-target="combo" aria-live="polite" aria-atomic="true">
      <span class="combo-band relative flex h-full items-center justify-center gap-2 rounded-2xl bg-gray-900 text-white shadow-sm" data-process-mode-target="band">
        <span class="text-2xl font-black tabular-nums" data-process-mode-target="count">0</span>
        <span class="combo-label text-sm font-bold tracking-widest text-orange-300">COMBO</span>
        <%# 文字が出るたびに数字が横へずれないよう、帯の右端に浮かせる %>
        <span class="combo-cheer absolute right-4 top-1/2 -translate-y-1/2 font-black italic" data-process-mode-target="cheer"></span>
        <span class="combo-burst pointer-events-none absolute inset-0" data-process-mode-target="burst" aria-hidden="true"><% 10.times { |i| %><span style="--i: <%= i %>"></span><% } %></span>
      </span>
    </p>
  <% end %>
</div>

<section class="mt-3" aria-label="記事">
  <% if @articles.empty? %>
    <%= render "empty" %>
  <% else %>
    <ul class="swipe-list divide-y divide-gray-100 overflow-hidden rounded-2xl bg-white shadow-sm" data-process-mode-target="list"
        data-controller="accordion" data-accordion-swipe-outlet="[data-controller~='swipe']" data-action="swipe:expanded->accordion#collapseOthers">
      <% @articles.each do |article| %>
        <%= render "article_card", article: article %>
      <% end %>
    </ul>
    <div class="swipe-list-empty"><%= render "empty" %></div>
  <% end %>
</section>

<% unless @articles.empty? %>
  <dialog class="process-result m-auto w-[min(20rem,calc(100%-2rem))] rounded-3xl bg-white p-0 text-center text-gray-900 shadow-xl backdrop:bg-black/50"
          data-process-mode-target="result" data-action="click->process-mode#closeOnBackdrop" aria-labelledby="process-result-title">
    <div class="p-6">
      <h2 id="process-result-title" class="text-sm font-bold tracking-widest text-orange-600">リザルト</h2>
      <p class="mt-2 flex items-baseline justify-center gap-1">
        <span class="text-6xl font-black tabular-nums" data-process-mode-target="resultCount">0</span>
        <span class="text-xl font-bold">件</span>
      </p>
      <p class="text-sm text-gray-500">処理した</p>
      <dl class="mt-5 grid grid-cols-2 gap-2 text-left">
        <div class="rounded-2xl bg-gray-100 px-3 py-2">
          <dt class="text-xs text-gray-500">タイム</dt>
          <dd class="text-lg font-bold tabular-nums" data-process-mode-target="resultTime"></dd>
        </div>
        <div class="rounded-2xl bg-gray-100 px-3 py-2">
          <dt class="text-xs text-gray-500">1 件あたり</dt>
          <dd class="text-lg font-bold tabular-nums" data-process-mode-target="resultPace"></dd>
        </div>
      </dl>
      <form method="dialog" class="mt-5">
        <button class="h-11 w-full rounded-xl bg-orange-500 font-bold text-white active:bg-orange-600">閉じる</button>
      </form>
    </div>
  </dialog>
<% end %>
</div>

<%= render "tab_bar" %>
