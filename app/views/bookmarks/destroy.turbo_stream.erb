<% if @from_saved %>
  <%= turbo_stream.replace dom_id(@article) do %>
    <%= render "shared/hidden_row", article: @article %>
  <% end %>
  <%= turbo_stream.update "toast" do %>
    <%= render "shared/undo_toast", message: "1 件の保存を外しました", undo: { path: article_bookmark_path(@article, from: "saved") }, swipe: params[:swipe].to_i %>
  <% end %>
  <%= turbo_stream.update "saved-count", @saved_count.to_s %>
<% else %>
  <% if Article.unread.exists?(@article.id) %>
    <%= turbo_stream.replace dom_id(@article) do %>
      <%= render "main/article_card", article: @article %>
    <% end %>
  <% else %>
    <%= turbo_stream.remove dom_id(@article) %>
  <% end %>
  <%= turbo_stream.update "toast", "" %>
<% end %>
<%= render "shared/unread_count_streams", unread_count: @unread_count %>
